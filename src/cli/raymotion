#!/usr/bin/env python3
"""raymotion: compile .ray programs to C++ and render frames."""
import argparse
import hashlib
import json
import shlex
from decimal import Decimal, InvalidOperation
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

VERSION = '0.1.0'
# Shared compiler is also consumed by editor integrations.
sys.path.insert(0, str(Path(__file__).resolve().parents[1]/'compiler'))
sys.path.insert(0, str(Path(__file__).resolve().parents[1]/'share/raymotion/compiler'))
from raymotion_compiler import transpile

def run(args, **kwargs):
    subprocess.run([str(a) for a in args], check=True, **kwargs)

def build():
    source=Path('main.ray')
    if not source.is_file(): raise ValueError('main.ray not found; run raymotion init first')
    folder=Path('.raymotion/build').resolve(); folder.mkdir(parents=True,exist_ok=True)
    cpp=folder/'main.cpp'
    generated=transpile(source.read_text())
    if not cpp.exists() or cpp.read_text()!=generated: cpp.write_text(generated)
    here=Path(__file__).resolve()
    prefix=here.parent.parent
    if (prefix/'lib/libraymotion_engine.a').is_file():
        library=prefix/'lib/libraymotion_engine.a'
    else:
        prefix=here.parents[2]
        if not (prefix/'CMakeLists.txt').is_file(): raise ValueError('raymotion runtime not found')
        engine=folder/'engine'
        run(['cmake','-S',prefix,'-B',engine,'-DCMAKE_BUILD_TYPE=Release','-DBUILD_TESTING=OFF'])
        run(['cmake','--build',engine,'--parallel'])
        library=engine/'libraymotion_engine.a'
    executable=folder/'main'
    dependencies=folder/'main.d'
    manifest=folder/'main.cache.json'
    compiler=os.environ.get('CXX','c++')
    command=[compiler,'-std=c++17','-O3','-pthread','-I',str(Path.cwd()),'-I',str(prefix/'include'),
             '-MMD','-MF',str(dependencies),str(cpp),str(library),
             '-framework','Foundation','-framework','Metal','-o',str(executable)]
    def fingerprint():
        if not dependencies.exists(): return None
        # Compiler dependency files escape spaces and continue long lines.
        names=shlex.split(dependencies.read_text().replace('\\\n','').split(':',1)[1])
        names += [str(library),shutil.which(compiler) or compiler]
        try:
            return {name:hashlib.sha256(Path(name).read_bytes()).hexdigest() for name in names}
        except OSError:
            return None
    current={'command':command,'dependencies':fingerprint()}
    try:
        cached=json.loads(manifest.read_text())
    except (OSError,ValueError):
        cached=None
    if not executable.exists() or current['dependencies'] is None or cached!=current:
        # Invalidate before compiling so a failed build cannot reuse an old executable.
        manifest.unlink(missing_ok=True)
        run(command)
        manifest.write_text(json.dumps({'command':command,'dependencies':fingerprint()}))
    return executable

def positive(value):
    n=int(value)
    if n<=0: raise argparse.ArgumentTypeError('must be a positive integer')
    return n

def positive_seconds(value):
    try:
        seconds = Decimal(value)
    except InvalidOperation:
        raise argparse.ArgumentTypeError('must be a positive finite number of seconds')
    if not seconds.is_finite() or seconds <= 0:
        raise argparse.ArgumentTypeError('must be a positive finite number of seconds')
    return seconds

def main():
    parser=argparse.ArgumentParser(prog='raymotion')
    parser.add_argument('--version',action='version',version='raymotion '+VERSION)
    sub=parser.add_subparsers(dest='command',required=True)
    init=sub.add_parser('init'); init.add_argument('path',nargs='?',default='.')
    sub.add_parser('build')
    export=sub.add_parser('export',add_help=False)
    export.add_argument('--help',action='help')
    export.add_argument('-t','--time',type=positive_seconds,default=Decimal('10'),
                        help='maximum video duration in seconds (default: 10)')
    export.add_argument('output',type=Path)
    for short,long,default in [('w','width',640),('h','height',360),('f','framerate',30),('s','sample',16)]:
        export.add_argument('-'+short,'--'+long,type=positive,default=default)
    export.add_argument('--restir',dest='restir',action=argparse.BooleanOptionalAction,default=True,
                        help='use ReSTIR direct lighting for clean low-sample renders (default: enabled)')
    args=parser.parse_args()
    if args.command=='init':
        root=Path(args.path)
        root.mkdir(parents=True,exist_ok=True)
        if (root/'main.ray').exists(): raise ValueError('main.ray already exists')
        (root/'assets').mkdir(exist_ok=True)
        (root/'main.ray').write_text('// Add OBJ models to assets/. Camera faces +Z at the origin.\n// void model = object.init("assets/model.obj");\n// object.push(model, {0, 0, 3});\nobject.render();\n')
        print('Initialized '+str(root.resolve()))
    elif args.command=='build':
        print('Built '+str(build()))
    else:
        ext=args.output.suffix.lower()
        if ext not in ('.png','.mp4'): raise ValueError('output must end in .png or .mp4')
        if args.width*args.height>100_000_000: raise ValueError('image exceeds 100 million pixels')
        max_frames=0
        if ext=='.mp4':
            frame_count=args.time*args.framerate
            if frame_count<1 or frame_count>2147483647:
                raise ValueError('--time must allow between 1 and 2147483647 frames at this framerate')
            max_frames=int(frame_count)
            if args.width%2 or args.height%2: raise ValueError('MP4 width and height must be even')
            if not shutil.which('ffmpeg'): raise ValueError('MP4 export requires ffmpeg in PATH')
        executable=build()
        output=args.output.resolve(); output.parent.mkdir(parents=True,exist_ok=True)
        render_env=dict(os.environ)
        render_env['RAYMOTION_RESTIR']='1' if args.restir else '0'
        with tempfile.TemporaryDirectory(prefix='raymotion-') as temp:
            target=Path(temp)/'output.png' if ext=='.png' else Path(temp)
            run([executable,target,args.width,args.height,args.sample,args.framerate,ext[1:],max_frames],env=render_env)
            if ext=='.mp4':
                target=Path(temp)/'output.mp4'
                run(['ffmpeg','-hide_banner','-loglevel','error','-y','-framerate',args.framerate,'-i',Path(temp)/'f%08d.ppm','-c:v','libx264','-pix_fmt','yuv420p','-movflags','+faststart',target])
            shutil.copyfile(target,output)
        print('Exported '+str(output))

if __name__=='__main__':
    try: main()
    except (ValueError,OSError,subprocess.CalledProcessError) as e:
        print('raymotion: '+str(e),file=sys.stderr); sys.exit(1)
